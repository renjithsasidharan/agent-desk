# Groww API credentials. Edit with: sudo nano /etc/trader/secrets.env
GROWW_API_KEY=
# Fill ONE of these, depending on the key type you created on Groww:
# TOTP key (logs in by itself every morning): the TOTP secret Groww showed (the text behind the QR code)
GROWW_TOTP_SECRET=
# Approval key (needs approving in the Groww app every day): the API secret
GROWW_API_SECRET=
